<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 회의 영상 통화(WebRTC) — 카메라/마이크는 통화 참가 시 런타임 권한으로 요청한다 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 통화 중 화면 공유(D9) — API 29+는 mediaProjection 타입 FGS가 있어야 캡처가 허용된다 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name="kr.hhp227.storygroup.StoryGroupApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- adjustResize: 키보드가 창을 팬(pan)시키며 상단바까지 밀어올리지 않게 —
             ime 인셋으로 전달되어 화면의 imePadding이 소화한다(작성 화면 상단바 고정) -->
        <activity
            android:exported="true"
            android:name="kr.hhp227.storygroup.MainActivity"
            android:theme="@style/Theme.StoryGroup.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="kr.hhp227.storygroup.ui.rtc.ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>

</manifest>
